pcr.seqs(fasta=silva.seed_v138_2.align, start=11894, end=25319, keepdots=F, processors=2)
rename.file(input=silva.seed_v138_2.pcr.align, new=silva.v4.fasta)
make.contigs(file=stability.files, maxambig=0, maxlength=275, maxhomop=8, processors=2)
unique.seqs(fasta=stability.trim.contigs.fasta, count=stability.contigs.count_table)
align.seqs(fasta=current, reference=silva.v4.fasta, processors=2)
screen.seqs(fasta=current, count=current, start=1969, end=11551, processors=2)
filter.seqs(fasta=current, vertical=T, trump=., processors=2)
unique.seqs(fasta=current, count=current)
pre.cluster(fasta=current, count=current, diffs=2, processors=2)
chimera.uchime(fasta=current, count=current, dereplicate=t, processors=2)
classify.seqs(fasta=current, count=current, reference=silva.v4.fasta, taxonomy=silva.seed_v138_2.tax, processors=2)
remove.lineage(fasta=current, count=current, taxonomy=current, taxon=Chloroplast-Mitochondria-unknown-Archaea-Eukaryota)
remove.groups(count=current, fasta=current, taxonomy=current, groups=Mock)
summary.seqs(fasta=current, count=current)
